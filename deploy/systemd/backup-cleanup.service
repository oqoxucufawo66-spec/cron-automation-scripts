# /etc/systemd/system/backup-cleanup.service  (started by backup-cleanup.timer)
[Unit]
Description=Backup and cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=automation
WorkingDirectory=/opt/cron-automation-scripts
ExecStart=/opt/cron-automation-scripts/.venv/bin/python -m scripts.backup_cleanup --clean logs --notify
Nice=10
# Hardening: /usr, /boot and /etc are read-only for the job, private /tmp
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
