# /etc/systemd/system/report-to-telegram.service  (started by report-to-telegram.timer)
[Unit]
Description=Daily report to Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=automation
WorkingDirectory=/opt/cron-automation-scripts
ExecStart=/opt/cron-automation-scripts/.venv/bin/python -m scripts.report_to_telegram
Nice=10
# Hardening: /usr, /boot and /etc are read-only for the job, private /tmp
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
