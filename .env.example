# --- Telegram (for report_to_telegram and --notify). Never commit the real .env! ---
# Token from @BotFather; chat id: write to your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and take message.chat.id
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
TELEGRAM_CHAT_ID=123456789

# --- Parser ---
PARSER_START_URL=https://quotes.toscrape.com/
PARSER_OUTPUT_DIR=output
# 0 = all pages
PARSER_MAX_PAGES=0
# Delay between requests, seconds
PARSER_DELAY=1.0

# --- Backup & cleanup ---
# Comma separated; relative paths are resolved from the project folder
BACKUP_SOURCES=output
BACKUP_DEST=backups
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_LAST=3
CLEAN_PATTERN=*.log
CLEAN_DAYS=30

# --- Report ---
REPORT_DISK_PATH=/
REPORT_MAX_BACKUP_AGE_HOURS=26

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/cron.log
